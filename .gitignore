# Per-machine paths and options (never commit personal config)
/config.json
/config.local.json
.env
.env.*
!.env.example

# Python / OS metadata
__pycache__/
*.py[cod]
.DS_Store
.venv/
.pytest_cache/

# Temporary backups / local-only status and diagnostic logs
/data/.logseq-stage-*/
/data/.*-previous-*/
/.backup-status.json
/logs/
*.tmp

# Credentials / private keys (do not put them in the repository)
*.pem
*.key
*.p12
*.p8

# SQLite auxiliary files (never commit live WAL or SHM)
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

# Single-run advisory lock for macOS logpush
/.logseq-backup.lock
